msgstr "_crossref:colors[colors,Colores]_"

#. type: preface
#: documentation/content/en/books/accessibility/preface/_index.adoc:74
msgid ""
"Describes how to customize color settings in graphical environments for "
"better visibility."
msgstr ""
"Describe como configurar colores en entornos gráficos para mejorar su "
"visibilidad."

#. type: Labeled list
